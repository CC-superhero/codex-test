page {
  background: #f5f6fa;
  color: #1f2937;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #6b7280;
}

.price {
  color: #e63946;
  font-size: 34rpx;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-warn {
  background: #fff3cd;
  color: #a16207;
}

.tag-danger {
  background: #ffe2e5;
  color: #b42318;
}

.tag-ok {
  background: #dcfce7;
  color: #15803d;
}

.btn-primary {
  background: #e63946;
  color: #ffffff;
}

.btn-secondary {
  background: #1d3557;
  color: #ffffff;
}

.btn-light {
  background: #f3f4f6;
  color: #111827;
}

.empty {
  text-align: center;
  color: #6b7280;
  padding: 100rpx 20rpx;
}

.form-group {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hero {
  background: linear-gradient(135deg, #1d3557, #457b9d);
  border-radius: 24rpx;
  color: #ffffff;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  opacity: 0.88;
  font-size: 24rpx;
}

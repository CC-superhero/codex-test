<view class="page">
  <view wx:if="{{!list.length}}" class="empty">暂无优惠券</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row">
      <view class="section-title">{{item.name}}</view>
      <view
        class="tag {{item.status === 0 ? 'tag-ok' : item.status === 1 ? 'tag-warn' : 'tag-danger'}}"
      >
        {{item.status === 0 ? '未使用' : item.status === 1 ? '已使用' : '已过期'}}
      </view>
    </view>
    <view class="price">¥{{item.faceValue}}</view>
    <view class="muted" style="margin-top: 12rpx;">有效期：{{item.expireTime}}</view>
  </view>
</view>

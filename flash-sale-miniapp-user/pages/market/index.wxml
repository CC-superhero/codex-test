<view class="page">
  <view wx:if="{{!list.length}}" class="empty">暂无在售商品</view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="section-title">{{item.productName}}</view>
    <view class="price">¥{{item.price}}</view>
    <view class="muted" style="margin: 12rpx 0 18rpx;">商品编号：{{item.productId}}</view>
    <button
      class="btn-primary"
      data-id="{{item.id}}"
      loading="{{submittingId === item.id}}"
      bindtap="handleBuy"
    >
      立即购买
    </button>
  </view>
</view>

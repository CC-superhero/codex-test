<view class="page">
  <view class="hero">
    <view class="hero-title">限时秒杀</view>
    <view class="hero-subtitle">抢购、仓库、转卖市场一体化用户端</view>
  </view>

  <view wx:if="{{!products.length && !loading}}" class="empty">暂无可展示商品</view>

  <view
    wx:for="{{products}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="row">
      <view class="section-title">{{item.name}}</view>
      <view
        class="tag {{item.status === 1 ? 'tag-danger' : item.status === 0 ? 'tag-warn' : 'tag-ok'}}"
      >
        {{item.status === 0 ? '未开始' : item.status === 1 ? '进行中' : '已结束'}}
      </view>
    </view>
    <view class="price">¥{{item.price}}</view>
    <view class="muted" style="margin-top: 12rpx;">剩余库存：{{item.remainStock}} / {{item.totalStock}}</view>
    <view class="muted" style="margin-top: 8rpx;">{{item.startTime}} ~ {{item.endTime}}</view>
  </view>
</view>

<view class="page">
  <view class="card">
    <view class="section-title">用户登录</view>
    <input
      class="we-input"
      placeholder="请输入昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
    />
    <button class="btn-primary" loading="{{loading}}" bindtap="handleLogin" style="margin-top: 24rpx;">
      登录
    </button>
    <button class="btn-light" bindtap="goRegister" style="margin-top: 16rpx;">去注册</button>
  </view>
</view>
